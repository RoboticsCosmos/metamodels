      "AngularVelocityVectorXYZ": "geom-coord:AngularVelocityVectorXYZ",

      "AngleAboutZ": "geom-coord:AngleAboutZ",

      "of": {
        "@id": "geom-coord:of",
        "@type": "@id"
      }
    }
  ]
}