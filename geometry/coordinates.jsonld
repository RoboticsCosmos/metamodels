      "AngularDistanceCoordinate": "geom-coord:AngularDistanceCoordinate",

      "PositionVectorX": "geom-coord:PositionVectorX",
      "PositionVectorY": "geom-coord:PositionVectorY",
      "PositionVectorZ": "geom-coord:PositionVectorZ",
      "PositionVectorXY": "geom-coord:PositionVectorXY",
      "PositionVectorXZ": "geom-coord:PositionVectorXZ",
      "PositionVectorYZ": "geom-coord:PositionVectorYZ",
      "PositionVectorXYZ": "geom-coord:PositionVectorXYZ",

      "OrientationAboutX": "geom-coord:OrientationAboutX",
      "OrientationAboutY": "geom-coord:OrientationAboutY",
      "OrientationAboutZ": "geom-coord:OrientationAboutZ",
      "OrientationAboutXY": "geom-coord:OrientationAboutXY",
      "OrientationAboutXZ": "geom-coord:OrientationAboutXZ",
      "OrientationAboutYZ": "geom-coord:OrientationAboutYZ",
      "OrientationAboutXYZ": "geom-coord:OrientationAboutXYZ",

      "DistanceVectorX": "geom-coord:DistanceVectorX",
      "DistanceVectorY": "geom-coord:DistanceVectorY",
      "DistanceVectorZ": "geom-coord:DistanceVectorZ",
      "DistanceVectorXY": "geom-coord:DistanceVectorXY",
      "DistanceVectorXZ": "geom-coord:DistanceVectorXZ",
      "DistanceVectorYZ": "geom-coord:DistanceVectorYZ",
      "DistanceVectorXYZ": "geom-coord:DistanceVectorXYZ",

      "LinearVelocityVectorX": "geom-coord:LinearVelocityVectorX",
      "LinearVelocityVectorY": "geom-coord:LinearVelocityVectorY",
      "LinearVelocityVectorZ": "geom-coord:LinearVelocityVectorZ",
      "LinearVelocityVectorXY": "geom-coord:LinearVelocityVectorXY",
      "LinearVelocityVectorXZ": "geom-coord:LinearVelocityVectorXZ",
      "LinearVelocityVectorYZ": "geom-coord:LinearVelocityVectorYZ",
