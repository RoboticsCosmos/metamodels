{
  "@context": {
    "rneSolver": "https://roboticscosmos.github.io/metamodels/solvers/rne_solver#",
    
    "RNESolver": "rneSolver:RNESolver",

    "external-wrench": {
      "@id": "achdSolver:external-wrench",
      "@type": "@id",
      "@container": "@set"
    },

    "root-link": {
      "@id": "achdSolver:root-link",
      "@type": "@id"
    },

    "tip-link": {
      "@id": "achdSolver:tip-link",
      "@type": "@id"
    }
  }
}
